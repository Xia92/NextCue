<Window x:Class="NextCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextCue"
        Width="310"
        Height="700"
        MinWidth="280"
        MaxWidth="420"
        MinHeight="500"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="CanResize"
        Background="#F7F7F5"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F7F5" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#171717" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#315F8C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE2E5" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#3F775A" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B02A37" />
        <SolidColorBrush x:Key="CompactScrollBarThumbBrush" Color="#D5D9DE" />
        <SolidColorBrush x:Key="CompactScrollBarThumbHoverBrush" Color="#BFC5CC" />
        <SolidColorBrush x:Key="CompactScrollBarThumbDraggingBrush" Color="#AEB5BE" />
        <Thickness x:Key="TaskInputContentInset">20,16,20,16</Thickness>

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style x:Key="TextButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style x:Key="CompactCompleteCircleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="Circle"
                                     Margin="2"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1.5" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Circle" Property="Fill" Value="#10315F8C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Circle" Property="Fill" Value="#10315F8C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#1A315F8C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.65" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="8"
                              Background="Transparent">
                            <Border x:Name="ThumbPill"
                                    Width="6"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource CompactScrollBarThumbBrush}"
                                    CornerRadius="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbPill" Property="Width" Value="8" />
                                <Setter TargetName="ThumbPill" Property="Background" Value="{StaticResource CompactScrollBarThumbHoverBrush}" />
                                <Setter TargetName="ThumbPill" Property="CornerRadius" Value="4" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbPill" Property="Width" Value="8" />
                                <Setter TargetName="ThumbPill" Property="Background" Value="{StaticResource CompactScrollBarThumbDraggingBrush}" />
                                <Setter TargetName="ThumbPill" Property="CornerRadius" Value="4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="8"
                              Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource CompactScrollBarPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CompactScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource CompactScrollBarPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="ExpandedRoot"
              AutomationProperties.AutomationId="ExpandedRoot"
              Margin="18"
              Focusable="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NextCue"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />

                    <Button x:Name="AlwaysOnTopButton"
                            AutomationProperties.AutomationId="AlwaysOnTopButton"
                            Grid.Column="1"
                            MinWidth="64"
                            Margin="0,0,6,0"
                            Padding="12,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ToggleAlwaysOnTop_Click"
                            Content="置顶" />
                    <Button x:Name="CollapseButton"
                            AutomationProperties.AutomationId="CollapseButton"
                            Grid.Column="2"
                            MinWidth="64"
                            Padding="12,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CollapseSidebar_Click"
                            Content="收起" />
                </Grid>

                <UniformGrid Grid.Row="1"
                             Columns="3"
                             Margin="0,12,0,0">
                    <Button x:Name="TaskTabButton"
                            AutomationProperties.AutomationId="TaskTabButton"
                            Height="32"
                            Margin="0,0,4,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="TaskTab_Click"
                            Content="任务" />
                    <Button x:Name="StatisticsTabButton"
                            AutomationProperties.AutomationId="StatisticsTabButton"
                            Height="32"
                            Margin="2,0,2,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="StatisticsTab_Click"
                            Content="统计" />
                    <Button x:Name="SettingsTabButton"
                            AutomationProperties.AutomationId="SettingsTabButton"
                            Height="32"
                            Margin="4,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SettingsTab_Click"
                            Content="设置" />
                </UniformGrid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="TaskPage"
                      AutomationProperties.AutomationId="TaskPage">
                    <Grid x:Name="TaskInputView"
                          AutomationProperties.AutomationId="TaskInputView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="One cue at a time."
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="千里之行，始于足下。"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <Button x:Name="ReturnToCurrentPlanButton"
                                        AutomationProperties.AutomationId="ReturnToCurrentPlanButton"
                                        Style="{StaticResource TextButtonStyle}"
                                        Height="28"
                                        Padding="6,0"
                                        Margin="0,0,4,0"
                                        Click="ReturnToCurrentPlan_Click"
                                        Content="返回当前任务" />
                                <Button x:Name="OpenPlanLibraryFromInputButton"
                                        AutomationProperties.AutomationId="OpenPlanLibraryFromInputButton"
                                        Style="{StaticResource TextButtonStyle}"
                                        Height="28"
                                        Padding="6,0"
                                        Click="OpenPlanLibrary_Click"
                                        Content="任务库" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="当前任务"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <Grid Grid.Row="2" Margin="0,8,0,14">
                            <TextBox x:Name="TaskTextBox"
                                     AutomationProperties.AutomationId="TaskTextBox"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="{StaticResource TaskInputContentInset}"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="14"
                                     TextChanged="TaskTextBox_TextChanged" />
                            <TextBox x:Name="TaskPlaceholderText"
                                     AutomationProperties.AutomationId="TaskPlaceholderText"
                                     Text="你现在想开始做什么？&#x0a;&#x0a;例如：&#x0a;根据已经读过的文献，开始修改我的博士研究计划。"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Focusable="False"
                                     IsHitTestVisible="False"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     Padding="{StaticResource TaskInputContentInset}"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="14"
                                     Foreground="{StaticResource MutedTextBrush}"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0" />
                        </Grid>

                        <Button Grid.Row="3"
                                AutomationProperties.AutomationId="CopyPlanningPromptButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Click="CopyPlanningPrompt_Click"
                                Content="复制任务拆解指令" />

                        <Button Grid.Row="4"
                                AutomationProperties.AutomationId="OpenImportButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40"
                                Margin="0,9,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OpenImportPanel_Click"
                                Content="粘贴 GPT 结果"
                                FontWeight="SemiBold" />

                        <Button Grid.Row="5"
                                AutomationProperties.AutomationId="OpenChatGptButton"
                                Style="{StaticResource TextButtonStyle}"
                                Height="34"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OpenChatGpt_Click"
                                Content="打开 ChatGPT" />

                        <TextBlock x:Name="FeedbackTextBlock"
                                   AutomationProperties.AutomationId="FeedbackTextBlock"
                                   Grid.Row="6"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed"
                                   FontSize="13" />
                    </Grid>

                    <ScrollViewer x:Name="ExecutionView"
                                  AutomationProperties.AutomationId="ExecutionView"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="当前任务"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button x:Name="CurrentPlanSelectorButton"
                                    AutomationProperties.AutomationId="CurrentPlanSelectorButton"
                                    Style="{StaticResource TextButtonStyle}"
                                    MinHeight="32"
                                    Margin="0,4,0,14"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OpenPlanLibrary_Click" />

                            <TextBlock Text="当前进度"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="ProgressTextBlock"
                                       AutomationProperties.AutomationId="ProgressTextBlock"
                                       Margin="0,4,0,8"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <ProgressBar x:Name="TaskProgressBar"
                                         AutomationProperties.AutomationId="TaskProgressBar"
                                         Height="6"
                                         Margin="0,0,0,18"
                                         Minimum="0"
                                         BorderThickness="0"
                                         Background="{StaticResource BorderBrush}"
                                         Foreground="{StaticResource AccentBrush}" />

                            <Border Padding="16"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="当前一步"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="CurrentStepNumberTextBlock"
                                               AutomationProperties.AutomationId="CurrentStepNumberTextBlock"
                                               Margin="0,10,0,0"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="CurrentStepTextBlock"
                                               AutomationProperties.AutomationId="CurrentStepTextBlock"
                                               Margin="0,8,0,17"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               LineHeight="30"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource PrimaryTextBrush}" />

                                    <Button x:Name="CompleteCurrentStepButton"
                                            AutomationProperties.AutomationId="CompleteCurrentStepButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="40"
                                            HorizontalAlignment="Stretch"
                                            Click="CompleteCurrentStep_Click"
                                            Content="完成" />

                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="EditCurrentStepButton"
                                                AutomationProperties.AutomationId="EditCurrentStepButton"
                                                Grid.Column="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="34"
                                                Click="EditCurrentStep_Click"
                                                Content="编辑" />
                                        <Button x:Name="StuckButton"
                                                AutomationProperties.AutomationId="StuckButton"
                                                Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="34"
                                                Click="StuckButton_Click"
                                                Content="我卡住了" />
                                    </Grid>

                                    <Button x:Name="PasteRefinedStepsButton"
                                            AutomationProperties.AutomationId="PasteRefinedStepsButton"
                                            Style="{StaticResource TextButtonStyle}"
                                            Height="30"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Click="PasteRefinedSteps_Click"
                                            Content="细化当前步骤" />

                                    <TextBlock x:Name="ExecutionFeedbackTextBlock"
                                               AutomationProperties.AutomationId="ExecutionFeedbackTextBlock"
                                               Margin="0,10,0,0"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"
                                               FontSize="13" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,20,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="任务轴"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button x:Name="CopyTaskAxisButton"
                                            AutomationProperties.AutomationId="CopyTaskAxisButton"
                                            Style="{StaticResource TextButtonStyle}"
                                            Height="28"
                                            Padding="8,0"
                                            Margin="0,0,4,0"
                                            Click="CopyTaskAxis_Click"
                                            Content="复制任务轴" />
                                    <Button x:Name="ManageTaskAxisButton"
                                            AutomationProperties.AutomationId="ManageTaskAxisButton"
                                            Style="{StaticResource TextButtonStyle}"
                                            Height="28"
                                            Padding="8,0"
                                            Click="ManageTaskAxis_Click"
                                            Content="调整任务轴" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="TaskAxisPanel"
                                        AutomationProperties.AutomationId="TaskAxisPanel" />

                            <Button x:Name="EndCurrentPlanButton"
                                    AutomationProperties.AutomationId="EndCurrentPlanButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="EndCurrentPlan_Click"
                                    Content="结束本轮任务" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="CompletionView"
                          AutomationProperties.AutomationId="CompletionView"
                          Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="✓"
                                       AutomationProperties.AutomationId="CompletionCheckTextBlock"
                                       HorizontalAlignment="Center"
                                       FontSize="46"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="本轮任务已完成"
                                       AutomationProperties.AutomationId="CompletionTitleTextBlock"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="千里之行，始于足下。"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="StatisticsPage"
                              AutomationProperties.AutomationId="StatisticsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="统计"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <UniformGrid Columns="2" Margin="0,16,0,18">
                            <Border Margin="0,0,5,10"
                                    Padding="12"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="今日完成步骤"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="TodayCompletedStepsTextBlock"
                                               AutomationProperties.AutomationId="TodayCompletedStepsTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="5,0,0,10"
                                    Padding="12"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="本周完成步骤"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="WeekCompletedStepsTextBlock"
                                               AutomationProperties.AutomationId="WeekCompletedStepsTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,5,0"
                                    Padding="12"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="已完成任务"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="CompletedPlansTextBlock"
                                               AutomationProperties.AutomationId="CompletedPlansTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="5,0,0,0"
                                    Padding="12"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="已结束任务"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="EndedPlansTextBlock"
                                               AutomationProperties.AutomationId="EndedPlansTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="最近任务"
                                   Margin="0,0,0,10"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="OpenTaskHistoryButton"
                                AutomationProperties.AutomationId="OpenTaskHistoryButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Stretch"
                                Click="OpenTaskHistory_Click"
                                Content="查看历史任务" />
                        <StackPanel x:Name="RecentPlanHistoryPanel"
                                    AutomationProperties.AutomationId="RecentPlanHistoryPanel" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage"
                              AutomationProperties.AutomationId="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="设置"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Text="窗口"
                                   Margin="0,18,0,12"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <CheckBox x:Name="AlwaysOnTopCheckBox"
                                  AutomationProperties.AutomationId="AlwaysOnTopCheckBox"
                                  Content="置顶显示"
                                  Checked="AlwaysOnTopCheckBox_Changed"
                                  Unchecked="AlwaysOnTopCheckBox_Changed" />
                        <CheckBox x:Name="StartupCollapsedCheckBox"
                                  AutomationProperties.AutomationId="StartupCollapsedCheckBox"
                                  Content="启动时收起"
                                  Checked="StartupCollapsedCheckBox_Changed"
                                  Unchecked="StartupCollapsedCheckBox_Changed" />
                        <CheckBox x:Name="MinimizeToTrayOnCloseCheckBox"
                                  AutomationProperties.AutomationId="MinimizeToTrayOnCloseCheckBox"
                                  Content="关闭窗口时最小化到托盘"
                                  Checked="MinimizeToTrayOnCloseCheckBox_Changed"
                                  Unchecked="MinimizeToTrayOnCloseCheckBox_Changed" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  AutomationProperties.AutomationId="StartWithWindowsCheckBox"
                                  Content="开机后启动 NextCue"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed" />

                        <TextBlock Text="桌面快捷方式"
                                   Margin="0,10,0,8"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DesktopShortcutStatusTextBlock"
                                   AutomationProperties.AutomationId="DesktopShortcutStatusTextBlock"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="CreateDesktopShortcutButton"
                                AutomationProperties.AutomationId="CreateDesktopShortcutButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="CreateDesktopShortcut_Click"
                                Content="创建桌面快捷方式" />
                        <Button x:Name="RemoveDesktopShortcutButton"
                                AutomationProperties.AutomationId="RemoveDesktopShortcutButton"
                                Style="{StaticResource TextButtonStyle}"
                                Height="30"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Click="RemoveDesktopShortcut_Click"
                                Content="移除桌面快捷方式" />

                        <TextBlock Text="停靠位置"
                                   Margin="0,16,0,10"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <RadioButton x:Name="DockLeftRadioButton"
                                     AutomationProperties.AutomationId="DockLeftRadioButton"
                                     GroupName="DockSide"
                                     Content="左侧"
                                     Checked="DockSideRadioButton_Changed" />
                        <RadioButton x:Name="DockRightRadioButton"
                                     AutomationProperties.AutomationId="DockRightRadioButton"
                                     GroupName="DockSide"
                                     Content="右侧"
                                     Checked="DockSideRadioButton_Changed" />

                        <TextBlock Text="数据"
                                   Margin="0,22,0,12"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="数据保存在本机。"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="数据存储位置"
                                   Margin="0,12,0,4"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DataLocationTextBlock"
                                   AutomationProperties.AutomationId="DataLocationTextBlock"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="ChangeDataLocationButton"
                                AutomationProperties.AutomationId="ChangeDataLocationButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Click="ChangeDataLocation_Click"
                                Content="更改位置" />
                        <Button x:Name="OpenDataFolderButton"
                                AutomationProperties.AutomationId="OpenDataFolderButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OpenDataFolder_Click"
                                Content="打开文件夹" />
                        <Button x:Name="RestoreDefaultDataLocationButton"
                                AutomationProperties.AutomationId="RestoreDefaultDataLocationButton"
                                Style="{StaticResource TextButtonStyle}"
                                Height="30"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Click="RestoreDefaultDataLocation_Click"
                                Content="恢复默认位置" />
                        <TextBlock x:Name="DataLocationStatusTextBlock"
                                   AutomationProperties.AutomationId="DataLocationStatusTextBlock"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="ImportPanel"
                    AutomationProperties.AutomationId="ImportPanel"
                    Grid.RowSpan="2"
                    Visibility="Collapsed"
                    Background="#CCF7F7F5">
                <Border Width="260"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="导入任务步骤"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBox x:Name="ImportTextBox"
                                 AutomationProperties.AutomationId="ImportTextBox"
                                 Grid.Row="1"
                                 Margin="0,14,0,12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock x:Name="ImportFeedbackTextBlock"
                                   AutomationProperties.AutomationId="ImportFeedbackTextBlock"
                                   Grid.Row="2"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"
                                   Text="未识别到任务步骤，请检查粘贴内容。"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button AutomationProperties.AutomationId="CancelImportButton"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="34"
                                    Click="CancelImport_Click"
                                    Content="取消" />
                            <Button AutomationProperties.AutomationId="GenerateTaskListButton"
                                    Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="34"
                                    Click="GenerateTaskList_Click"
                                    Content="生成任务列表" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <Border x:Name="CollapsedRoot"
                AutomationProperties.AutomationId="CollapsedRoot"
                Visibility="Collapsed"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource WindowBackgroundBrush}"
                Cursor="Arrow">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="CollapsedHeader"
                      AutomationProperties.AutomationId="CollapsedHeader"
                      Grid.Row="0"
                      Height="38"
                      Background="Transparent"
                      MouseLeftButtonDown="CollapsedHeader_MouseLeftButtonDown"
                      MouseMove="CollapsedHeader_MouseMove"
                      MouseLeftButtonUp="CollapsedHeader_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="CollapsedBrandIcon"
                           AutomationProperties.AutomationId="CollapsedBrandIcon"
                           Width="22"
                           Height="22"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           Cursor="Hand"
                           MouseLeftButtonUp="CollapsedBrandIcon_MouseLeftButtonUp" />
                    <TextBlock Grid.Column="1"
                               Text="⋮⋮"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{StaticResource MutedTextBrush}"
                               Cursor="SizeAll" />
                    <Button x:Name="CollapsedExpandButton"
                            AutomationProperties.AutomationId="CollapsedExpandButton"
                            Grid.Column="2"
                            Width="26"
                            Height="28"
                            Margin="0,0,8,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            FontSize="18"
                            Cursor="Hand"
                            Click="ExpandSidebar_Click">
                        <TextBlock x:Name="CollapsedArrowTextBlock"
                                   AutomationProperties.AutomationId="CollapsedArrowTextBlock"
                                   Text="&lt;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="12,18,12,12">
                    <TextBlock x:Name="CollapsedNoActivePlanTextBlock"
                               AutomationProperties.AutomationId="CollapsedNoActivePlanTextBlock"
                               Text="暂无进行中的任务"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <Grid x:Name="CollapsedPlanPanel"
                          AutomationProperties.AutomationId="CollapsedPlanPanel"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="CollapsedCurrentStepRow"
                                           Height="*"
                                           MinHeight="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="当前步骤"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />

                            <Button x:Name="CollapsedCompleteCurrentStepButton"
                                    AutomationProperties.AutomationId="CollapsedCompleteCurrentStepButton"
                                    Style="{StaticResource CompactCompleteCircleButtonStyle}"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="CompleteCurrentStep_Click"
                                    Content="" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource CompactScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <TextBlock x:Name="CollapsedCurrentStepTextBlock"
                                           AutomationProperties.AutomationId="CollapsedCurrentStepTextBlock"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           LineHeight="25"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </ScrollViewer>
                        </Grid>

                        <Border x:Name="CollapsedNextStepDivider"
                                AutomationProperties.AutomationId="CollapsedNextStepDivider"
                                Grid.Row="2"
                                Height="1"
                                Margin="0,14,0,12"
                                Background="{StaticResource BorderBrush}" />
                        <TextBlock x:Name="CollapsedNextStepLabelTextBlock"
                                   AutomationProperties.AutomationId="CollapsedNextStepLabelTextBlock"
                                   Grid.Row="3"
                                   Text="下一步"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="CollapsedNextStepTextBlock"
                                   AutomationProperties.AutomationId="CollapsedNextStepTextBlock"
                                   Grid.Row="4"
                                   Margin="0,7,0,0"
                                   MinHeight="42"
                                   MaxHeight="54"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Opacity="0.68"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <StackPanel x:Name="CollapsedCompletionPanel"
                                AutomationProperties.AutomationId="CollapsedCompletionPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="✓"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="本轮任务已完成"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="千里之行，始于足下。"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
